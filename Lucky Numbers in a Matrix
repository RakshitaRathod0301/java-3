import java.util. Scanner;
class Solution {
public List<Integer> luckyNumbers(int[][] matrix) { List<Integer> result = new ArrayList<>();
for (int i = 0; i < matrix.length; i++) {
int min = matrix[i][0];
int col = 0;
for (int j = 1; j < matrix[i].length; j++) {
if (matrix[i][j] < min) {
min = matrix[i][j];
col = j;
}
}
boolean largest = true;
for (int k = 0; k < matrix.length; k++) {
if (matrix[k][col] > min) {
largest = false;
break;
}
}
if (largest) {
result.add(min);
}
}
return result;
}
}